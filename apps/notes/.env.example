# 在 apps/notes 複製成 .env 後填入。.env 不會進 git。
# 產生隨機值：openssl rand -hex 32

# 原始擁有者的 MCP token，可以讀寫，至少 32 字元。其他人在筆記網站的「Token」頁自己產生
MCP_TOKEN=

# 筆記網站（Vercel）連 API 用的 token，至少 32 字元，不要和 MCP_TOKEN 相同。Vercel 那邊要設一樣的值
API_TOKEN=

# 筆記網站用 RAG 帳號登入，這裡填 RAG 的 API 網址（必填）
RAG_API_URL=https://rag.name404.com

# 背景同步用來加密使用者的 RAG 憑證，至少 32 字元。不填就不會同步。換掉後大家要重新登入一次
SYNC_KEY=

# 公開知識寫進哪個 Space（帳號要是該 Space 的 owner 或 member）。不填就不同步公開專案
RAG_PUBLIC_ACCOUNT=
RAG_PUBLIC_PASSWORD=
RAG_PUBLIC_SPACE_ID=

# 多人化之前的筆記要歸給哪個 RAG 使用者（數字）。第一次登入前就要設定
NOTES_OWNER_RAG_USER_ID=

# docker compose 用的資料庫密碼（只用英數，避免連線字串要跳脫）
POSTGRES_PASSWORD=

# 不用 docker compose、直接跑 npm run dev 時才需要
# DATABASE_URL=postgres://notes:密碼@localhost:5432/learning_notes

# npm run sync:rag 用：筆記從這個 MCP 讀（搭配上面的 MCP_TOKEN），不填就改用 DATABASE_URL
# NOTES_MCP_URL=https://notes-api.doraeyi.com/mcp

# npm run sync:rag 用：把筆記同步到 RAG 自己的 Space。不填就只預覽，不連線
# RAG_ACCOUNT=
# RAG_PASSWORD=
# 不填用帳號的預設 Space
# RAG_SPACE_ID=

# 綁在本機的 port，由 Nginx 轉發。和主機上其他服務撞到時才要改
NOTES_API_PORT=8008
