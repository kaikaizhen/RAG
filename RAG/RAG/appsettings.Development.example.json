{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=<DB_HOST>;Port=<DB_PORT>;Database=<DB_NAME>;User=<DB_USER>;Password=<DB_PASSWORD>;CharSet=utf8mb4;"
  },
  "SkillRuntime": {
    "Root": "../../docs/skill-registry"
  },
  "Registration": {
    "Enabled": false,
    "VerifyUrlBase": "http://localhost:3000/verify-email"
  },
  "Library": {
    "Mail": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseSsl": true,
      "Account": "<Gmail 帳號>",
      "Password": "<Gmail 應用程式密碼；請改用環境變數 Library__Mail__Password，不要寫進檔案>",
      "DefaultFromName": "RAGence"
    }
  },
  "RagOption": {
    "BaseUrl": "http://localhost:8007",
    "InternalApiKey": "<與 RAG_Server 的 INTERNAL_API_KEY 相同的隨機字串>"
  }
}
