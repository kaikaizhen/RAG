<?xml version="1.0" encoding="utf-8"?>
<!--
  BaGet 為私有套件來源（提供內部的 Library 套件）。
  請將環境變數 NUGET_PRIVATE_FEED 設為自己的私有 NuGet v3 index，例如：
      http://<your-baget-host>:5555/v3/index.json
  若不需要私有來源，可直接刪除該 <add> 節點。
-->
<configuration>
  <packageSources>
    <add key="BaGet" value="%NUGET_PRIVATE_FEED%" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
