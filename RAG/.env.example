# RAG (.NET API) 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env

# 共用 Library 原始碼資料夾（建置映像時以 build context 帶入，不使用 NuGet / BaGet）
LIBRARY_PATH=../../Library

# MySQL 連線字串
DB_CONNECTION_STRING=Server=<DB_HOST>;Port=<DB_PORT>;Database=<DB_NAME>;User=<DB_USER>;Password=<DB_PASSWORD>;CharSet=utf8mb4;

# RAG_Server (FastAPI) 位址
RAG_SERVER_BASE_URL=http://localhost:8007

# 呼叫 RAG_Server 的內部金鑰（與 RAG_Server 的 INTERNAL_API_KEY 相同），請以隨機字串取代
RAG_INTERNAL_API_KEY=<請以隨機字串取代>

# ---- 自行註冊 + Gmail 驗證信（預設關閉）----
# 啟用前需先執行 RAG/Migrations/Scripts/20261107-email-registration-columns.sql
REGISTRATION_ENABLED=false
# 前端驗證頁的完整網址（信中連結為「此網址?token=...」）
REGISTRATION_VERIFY_URL_BASE=https://<前端網域>/verify-email
# Gmail：帳號需開啟兩步驟驗證，並建立「應用程式密碼」（不是登入密碼）。此檔不可進版控。
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_SSL=true
MAIL_ACCOUNT=<Gmail 帳號>
MAIL_PASSWORD=<Gmail 應用程式密碼>
MAIL_FROM_NAME=RAGence
