# RAG (.NET API) 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env

# 私有 NuGet (BaGet) v3 index
NUGET_PRIVATE_FEED=http://<your-baget-host>:5555/v3/index.json

# MySQL 連線字串
DB_CONNECTION_STRING=Server=<DB_HOST>;Port=<DB_PORT>;Database=<DB_NAME>;User=<DB_USER>;Password=<DB_PASSWORD>;CharSet=utf8mb4;

# RAG_Server (FastAPI) 位址
RAG_SERVER_BASE_URL=http://localhost:8007

# 呼叫 RAG_Server 的內部金鑰（與 RAG_Server 的 INTERNAL_API_KEY 相同），請以隨機字串取代
RAG_INTERNAL_API_KEY=<請以隨機字串取代>
