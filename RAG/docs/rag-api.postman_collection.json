{
  "info": {
    "name": "RAG API（.NET 後端）",
    "description": "1) 到 Collection 的 Variables 填 account / password；2) 執行「驗證功能模組 → POST /Auth/Login」，token 會自動存入；3) 其餘請求自動帶 Bearer。要切換 Space 時，啟用請求上的 X-Space-Id 標頭並填 spaceId。access token 過期（3 小時）時執行 /Auth/Refresh。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://rag.name404.com"
    },
    {
      "key": "account",
      "value": ""
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "spaceId",
      "value": ""
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "驗證功能模組",
      "item": [
        {
          "name": "POST /Auth/Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Space-Id",
                "value": "{{spaceId}}",
                "disabled": true,
                "description": "指定 Space；留空 / 停用則使用預設 Space"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/Login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Auth",
                "Login"
              ],
              "query": [],
              "variable": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"account\": \"{{account}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const r = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', r.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /Auth/Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Space-Id",
                "value": "{{spaceId}}",
                "disabled": true,
                "description": "指定 Space；留空 / 停用則使用預設 Space"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/Auth/Refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "Auth",
                "Refresh"
              ],
              "query": [],
              "variable": []
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const r = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', r.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', r.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /Auth/Register",
          "request": {
