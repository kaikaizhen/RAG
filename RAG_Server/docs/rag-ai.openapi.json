{
  "openapi": "3.1.0",
  "info": {
    "title": "RAG API",
    "version": "0.1.0",
    "description": "RAG 向量服務（內部服務）。除 `GET /` 外，所有端點都需要 `X-Internal-Api-Key` 標頭，由 .NET API 與本服務共用；請勿對外公開。"
  },
  "paths": {
    "/": {
      "get": {
        "summary": "Read Root",
        "operationId": "read_root__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/questionsToVector": {
      "post": {
        "summary": "Api Questions To Vector",
        "operationId": "api_questions_to_vector_questionsToVector_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/QuestionListRequest"
              },
              "example": {
                "space_id": 1,
                "questions": [
                  {
                    "id": 1,
                    "referenceId": null,
                    "qaTypeId": 1,
                    "qaItemTypeId": 1,
                    "question": "範例問題",
                    "answer": "範例答案（支援 Markdown）"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    },
    "/ask": {
      "post": {
        "summary": "Api Ask",
        "operationId": "api_ask_ask_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              },
              "example": {
                "space_id": 1,
                "question": "什麼是三層式架構？",
                "type": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    },
    "/search": {
      "post": {
        "summary": "Api Search",
        "operationId": "api_search_search_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SearchRequest"
              },
              "example": {
                "space_id": 1,
                "query": "Docker 如何建置映像檔",
                "limit": 5,
                "type": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    },
    "/questions/{question_id}": {
      "delete": {
        "summary": "Api Delete Question",
        "operationId": "api_delete_question_questions__question_id__delete",
        "parameters": [
          {
            "name": "question_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Question Id"
            }
          },
          {
            "name": "space_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Space Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    },
    "/collections": {
      "get": {
        "summary": "Api Get Collections",
        "operationId": "api_get_collections_collections_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    },
    "/model_status": {
      "get": {
        "summary": "Get Model Status",
        "operationId": "get_model_status_model_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    },
    "/questions": {
      "get": {
        "summary": "List Questions",
        "description": "列出指定 Space 的問題",
        "operationId": "list_questions_questions_get",
        "parameters": [
          {
            "name": "space_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "title": "Space Id"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 1000,
              "exclusiveMinimum": 0,
              "default": 100,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "InternalKey": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AskRequest": {
        "properties": {
          "space_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Space Id"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "space_id",
          "question"
        ],
        "title": "AskRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "QuestionListRequest": {
        "properties": {
          "space_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Space Id"
          },
          "questions": {
            "items": {
              "$ref": "#/components/schemas/QuestionRequest"
            },
            "type": "array",
            "title": "Questions"
          }
        },
        "type": "object",
        "required": [
          "space_id",
          "questions"
        ],
        "title": "QuestionListRequest"
      },
      "QuestionRequest": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "referenceid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Referenceid"
          },
          "qatypeid": {
            "type": "integer",
            "title": "Qatypeid"
          },
          "qaitemtypeid": {
            "type": "integer",
            "title": "Qaitemtypeid"
          },
          "question": {
            "type": "string",
            "title": "Question"
          },
          "answer": {
            "type": "string",
            "title": "Answer"
          }
        },
        "type": "object",
        "required": [
          "id",
          "qatypeid",
          "qaitemtypeid",
          "question",
          "answer"
        ],
        "title": "QuestionRequest"
      },
      "SearchRequest": {
        "properties": {
          "space_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Space Id"
          },
          "query": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query"
          },
          "limit": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Limit",
            "default": 10
          },
          "type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Type"
          }
        },
        "type": "object",
        "required": [
          "space_id",
          "query"
        ],
        "title": "SearchRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "InternalKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Internal-Api-Key"
      }
    }
  },
  "servers": [
    {
      "url": "https://rag.name404.com/ai",
      "description": "NAS（經 Nginx /ai/）"
    },
    {
      "url": "http://localhost:8007",
      "description": "本機"
    }
  ]
}
