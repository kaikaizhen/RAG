# RAG_Server (FastAPI) 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env

# Qdrant 向量資料庫位址
QDRANT_HOST=localhost
QDRANT_PORT=6333
# bge-m3（1024 維）使用新 collection；舊 rag_knowledge（384 維）保留供回退
QDRANT_COLLECTION=rag_knowledge_bge_m3

# 中英雙語 embedding 模型（約 2.3GB，首次啟動會下載）；更換模型必須使用新 collection 並以 scripts/reindex_from_export.py 重建
EMBEDDING_MODEL=BAAI/bge-m3

# CORS 允許來源，多筆以逗號分隔；* 代表全部允許（建議正式環境明確指定）
CORS_ORIGINS=*

# .NET API 呼叫本服務的內部金鑰（必須與 .NET 的 RagOption__InternalApiKey 相同）
# 未設定時所有受保護端點一律回 401。請以隨機字串取代，例如：openssl rand -base64 32
INTERNAL_API_KEY=<請以隨機字串取代>
