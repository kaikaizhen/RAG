# RAG_Server (FastAPI) 環境變數範本
# 複製為 .env 後填入實際值：cp .env.example .env

# Qdrant 向量資料庫位址
QDRANT_HOST=localhost
QDRANT_PORT=6333
# 更換 embedding 模型必須使用新 collection；舊 rag_knowledge_bge_m3（bge-m3 向量）保留供回退，以 scripts/reindex_from_export.py 重建新 collection
QDRANT_COLLECTION=rag_knowledge_v2

# Embedding 由遠端 Ollama 提供（/api/embed），本服務不載入本地模型；Ollama 失敗時回 503，不 fallback
OLLAMA_BASE_URL=http://192.168.0.188:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIMENSION=1024

# /ask 判斷門檻（依 qwen3-embedding:0.6b 校準；與 .NET ContextRuntime 由 compose/.env 注入同一組值）
# direct match：top1 >= DIRECT_MATCH_THRESHOLD 且 top1 - top2 >= DIRECT_MATCH_MARGIN；
# 介於 SIMILAR_SCORE_THRESHOLD 與 direct 條件之間走內容摘要；低於 SIMILAR_SCORE_THRESHOLD 回「找不到足夠可靠資料」
DIRECT_MATCH_THRESHOLD=0.7
DIRECT_MATCH_MARGIN=0.05
SIMILAR_SCORE_THRESHOLD=0.50

# 掛在反向代理的子路徑下時設定（例如 /ai），讓 /docs 與 openapi.json 連結正確
RAG_ROOT_PATH=

# CORS 允許來源，多筆以逗號分隔；* 代表全部允許（建議正式環境明確指定）
CORS_ORIGINS=*

# .NET API 呼叫本服務的內部金鑰（必須與 .NET 的 RagOption__InternalApiKey 相同）
# 未設定時所有受保護端點一律回 401。請以隨機字串取代，例如：openssl rand -base64 32
INTERNAL_API_KEY=<請以隨機字串取代>
