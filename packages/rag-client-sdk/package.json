{
  "name": "@rag/client-sdk",
  "version": "0.1.0",
  "private": true,
  "description": "RAG API 共用 TypeScript client SDK（CLI / VS Code Extension / Web 共用）",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "generate": "openapi-typescript openapi/rag-api.v1.json -o src/generated/schema.ts",
    "check:generated": "node scripts/check-generated.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run tests/e2e.test.ts"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.1"
  }
}
